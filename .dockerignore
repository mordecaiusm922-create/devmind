*.pyc
benchmark
simulate_real_risks.py

# Runtime state -- must not be baked into the image; these are
# written to at runtime (local JSONL audit fallback, memory files),
# not read as static app code.
data
memory_store

# Local/editor cruft
.vscode
.idea
*.md