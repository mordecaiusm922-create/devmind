# Version control / CI, not needed at runtime
.git
.github
.gitignore

# Legacy pre-MCP-pivot code (backend/ = old FastAPI+Groq service,
# frontend/ = its React UI) -- devmind_server.py does not import
# from either; confirmed via grep before excluding.
backend
frontend

# Dev/test artifacts
tests
.pytest_cache
